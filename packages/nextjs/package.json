{
  "name": "@se-2/nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && next build && node scripts/check-client-bundle.mjs",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "check-types": "next typegen && tsc --noEmit --incremental",
    "dev": "next dev",
    "format": "prettier --write . '!(node_modules|.next|contracts)/**/*'",
    "lint": "eslint .",
    "serve": "next start",
    "start": "next dev",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:db:up": "docker compose -f test/docker-compose.yml up -d --wait",
    "test:db:down": "docker compose -f test/docker-compose.yml down",
    "test:e2e": "playwright test",
    "test:e2e:flows": "E2E_FLOWS=1 playwright test",
    "vercel": "vercel",
    "vercel:yolo": "vercel --build-env NEXT_PUBLIC_IGNORE_BUILD_ERROR=true"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "6.19.3",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "@supabase/supabase-js": "^2.116.0",
    "@zxing/library": "^0.21.3",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.3",
    "daisyui": "4.12.24",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lru-cache": "^11.0.2",
    "next": "16.3.5",
    "next-nprogress-bar": "^2.4.7",
    "next-themes": "^0.4.6",
    "prisma": "6.19.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dom-confetti": "^0.2.0",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/canvas-confetti": "^1",
    "@types/leaflet": "^1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "~3.4.19",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
