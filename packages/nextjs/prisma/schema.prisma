// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// PROD
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// DEV
// datasource db {
//   provider = "sqlite"
//   url      = env("DATABASE_URL_DEV")
// }

model Library {
  id String @id @default(cuid())
  locationName String
  longitude Float
  latitude Float
  curators User[] @relation("LibraryCurators")
  imageUrl String?
  description String?
  active Boolean @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  items Item[] @relation("LibraryItems")
}

// Wallet-based players from before accounts existed. Read-only: their points were copied into
// Account rows (prisma/sql/import-wallet-users.sql), claimable by that wallet later.
model User {
  id String @id @default(cuid())
  walletAddress String? @unique
  points Int @default(0)
  curatorOf Library[] @relation("LibraryCurators")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// An anonymous player, created the first time they earn points. No email or name is stored;
// a passkey lets them sign back in on any device.
model Account {
  id            String       @id @default(cuid())
  displayName   String       @unique
  points        Int          @default(0)
  // Linked later, to convert points into tokens.
  walletAddress String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  passkeys      Passkey[]
  pointEvents   PointEvent[]
  moderator     Moderator?
}

// Accounts allowed to hide libraries and books. The app can only read this table; a moderator is
// added by running SQL as the database owner (see prisma/sql/2026-09-13-moderation.sql).
model Moderator {
  accountId String   @id
  account   Account  @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now())
}

// Every hide and unhide, so moderation can be reviewed. Rows are never changed or deleted.
model ModerationEvent {
  id          String   @id @default(cuid())
  moderatorId String
  // "library" or "item"
  targetType  String
  targetId    String
  hidden      Boolean
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
}

model Passkey {
  // WebAuthn credential ID, base64url.
  id         String    @id
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  publicKey  Bytes
  counter    Int       @default(0)
  transports String?
  deviceType String
  backedUp   Boolean
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([accountId])
}

// Every point ever awarded, so totals can be audited before points become tokens.
model PointEvent {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  // ADD_BOOK, CONFIRM_BOOK, CREATE_LIBRARY, IMPORTED_WALLET_POINTS
  action    String
  points    Int
  libraryId String?
  itemId    String?
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}
model Item {
  id String @id @default(cuid())
  title String?
  sourceURL String?
  authors String?
  description String?
  thumbnail String?
  isbn13 String? 
  libraryId String?
  itemInfo String?
  // Hidden by a moderator: kept, but left out of every public list and count.
  hidden Boolean @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  library Library? @relation("LibraryItems", fields: [libraryId], references: [id])
}

model ArlibSettings {
  id String @unique
  booksNeededToNameLibrary Int
  seasonEndsAt DateTime
  totalItems Int
  totalLibraries Int
  updatedAt DateTime @updatedAt
}

model Poll {
  id String @id @default(cuid())
  questionId String
  rating Int @default(0)
  createdAt DateTime @default(now())
}