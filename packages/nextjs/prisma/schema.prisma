// https://pris.ly/d/prisma-schema

// `prisma generate` writes the client to lib/generated/prisma (not in Git); import it from there.
generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  // CommonJS: Playwright loads the test files (which use the client) as CommonJS.
  moduleFormat = "cjs"
}

// Connection strings live elsewhere: the site's in lib/prismaClient.ts, Prisma commands' in
// prisma.config.ts.
datasource db {
  provider = "postgresql"
}

model Library {
  id String @id @default(cuid())
  locationName String
  longitude Float
  latitude Float
  curators User[] @relation("LibraryCurators")
  imageUrl String?
  description String?
  active Boolean @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  items Item[] @relation("LibraryItems")
}

// Wallet-based players from before accounts existed. Read-only: their points were copied into
// Account rows (prisma/sql/import-wallet-users.sql), claimable by that wallet later.
model User {
  id String @id @default(cuid())
  walletAddress String? @unique
  points Int @default(0)
  curatorOf Library[] @relation("LibraryCurators")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// An anonymous player, created the first time they earn points. No email or name is stored;
// a passkey lets them sign back in on any device.
model Account {
  id            String       @id @default(cuid())
  displayName   String       @unique
  points        Int          @default(0)
  // Linked later, to convert points into tokens.
  walletAddress String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  passkeys      Passkey[]
  pointEvents   PointEvent[]
  moderator     Moderator?
}

// Accounts allowed to hide libraries and books. The app can only read this table; a moderator is
// added by running SQL as the database owner (see prisma/sql/2026-09-13-moderation.sql).
model Moderator {
  accountId String   @id
  account   Account  @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now())
}

// Every hide and unhide, so moderation can be reviewed. Rows are never changed or deleted.
model ModerationEvent {
  id          String   @id @default(cuid())
  moderatorId String
  // "library" or "item"
  targetType  String
  targetId    String
  hidden      Boolean
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
}

model Passkey {
  // WebAuthn credential ID, base64url.
  id         String    @id
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  publicKey  Bytes
  counter    Int       @default(0)
  transports String?
  deviceType String
  backedUp   Boolean
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  // A name the owner gave it ("Work laptop").
  name       String?
  // Which password manager holds it (e.g. Apple Passwords), as the authenticator reported it.
  aaguid     String?
  // Browser and device type, like "Safari on iPhone", so the owner can tell passkeys apart.
  createdFrom  String?
  lastUsedFrom String?
  // Removed by its owner: it no longer signs in. Kept because the app's database role can't delete.
  revokedAt  DateTime?

  @@index([accountId])
}

// Every point ever awarded, so totals can be audited before points become tokens.
model PointEvent {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  // ADD_BOOK, ADD_SEARCHED_BOOK, CONFIRM_BOOK, CREATE_LIBRARY, IMPORTED_WALLET_POINTS
  action    String
  points    Int
  libraryId String?
  itemId    String?
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}
model Item {
  id String @id @default(cuid())
  title String?
  sourceURL String?
  authors String?
  description String?
  thumbnail String?
  isbn13 String? 
  libraryId String?
  itemInfo String?
  // OpenLibrary edition id ("OL7353617M") of a book found by title search, for books without an ISBN.
  editionKey String?
  // How the book was added: "camera", "photo", "typed" or "search". Empty for books added before this was kept.
  addedVia String?
  // Hidden by a moderator: kept, but left out of every public list and count.
  hidden Boolean @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  library Library? @relation("LibraryItems", fields: [libraryId], references: [id])
}

// Books no catalog could find: an ISBN neither OpenLibrary nor Google Books knew, or a title search
// that ended without a match. Only what was looked up, when and where; nothing about the person.
// The app can add rows but not read them.
model LookupMiss {
  id        String   @id @default(cuid())
  // "isbn" or "search"
  kind      String
  // The ISBN, or the title and author searched for
  query     String
  libraryId String?
  createdAt DateTime @default(now())
}

model ArlibSettings {
  id String @unique
  booksNeededToNameLibrary Int
  seasonEndsAt DateTime
  totalItems Int
  totalLibraries Int
  updatedAt DateTime @updatedAt
}

model Poll {
  id String @id @default(cuid())
  questionId String
  rating Int @default(0)
  createdAt DateTime @default(now())
}